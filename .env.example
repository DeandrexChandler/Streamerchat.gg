# All optional. The app runs fully offline with zero keys set:
# transcription defaults to the browser's Web Speech API, and chat generation
# falls back to the deterministic pools/templates when no AI key is present.

# Optional — Whisper fallback for browsers without the Web Speech API.
# NOTE: must NOT be prefixed NEXT_PUBLIC_. That prefix inlines the value into
# the client bundle and ships your key to every visitor.
OPENAI_API_KEY=

# Optional — powers the AI generation tier (~5% of messages).
GOOGLE_API_KEY=
