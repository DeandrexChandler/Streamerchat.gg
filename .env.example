# Required for chat. Without it the simulator runs, but the audience says
# nothing — active chat is generated, never canned.
#
# NOTE: must NOT be prefixed NEXT_PUBLIC_. That prefix inlines the value into
# the client bundle and ships your key to every visitor.
GOOGLE_API_KEY=

# Optional — Whisper transcription for browsers without the Web Speech API.
# Transcription only; chat generation is Gemini regardless.
OPENAI_API_KEY=
