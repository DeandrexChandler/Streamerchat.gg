# Required for chat. Without it the simulator runs, but the audience says
# nothing — active chat is generated, never canned.
#
# NOTE: must NOT be prefixed NEXT_PUBLIC_. That prefix inlines the value into
# the client bundle and ships your key to every visitor.
GOOGLE_API_KEY=

# --- Billing (Track D). Leave all of these unset for local mode: unlimited,
# no database, no Stripe. Set them on the Vercel preview environment only.
#
# Stripe, TEST MODE ONLY (sk_test_...). Live keys are refused in code.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=
# Upstash Redis from the Vercel Marketplace; the integration sets these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
